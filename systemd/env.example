# Environment for the rec watch service.
# Everything here is optional; the defaults from the README apply while a line
# stays commented out.

#REC_OUT_DIR=/home/you/rec
#REC_ENGINE=whisper
#GEMINI_API_KEY=
#REC_MINUTES_CMD="claude -p"

# Run a command with the output directory once the minutes are written.
#REC_POST_CMD=rec-post

# Overrides the unit's PATH when the commands above live elsewhere.
#PATH=/home/you/bin:/home/you/.local/bin:/usr/local/bin:/usr/bin
