# Settings for rec, read by every run: manual ones and the watch service.
# Everything here is optional; the defaults from the README apply while a line
# stays commented out. A variable set in the shell wins over this file, and a
# flag wins over both.

#REC_OUT_DIR=/home/you/rec
#REC_ENGINE=whisper
#GEMINI_API_KEY=
#REC_MINUTES_CMD="claude -p"

# Run a command with the output directory once the minutes are written.
# Give an absolute path when it is not on the service's PATH.
#REC_POST_CMD=/home/you/.local/bin/rec-post
