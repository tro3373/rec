[Unit]
Description=rec - watch for calls and turn them into minutes
# Recording needs the session's PipeWire, so this can only be a user unit.
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
WorkingDirectory=%h
# The user manager does not inherit the login shell's PATH, and rec shells out
# to the minutes and post commands. rec reads ~/.config/rec/env on its own.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin
ExecStart=%h/.local/bin/rec watch
Restart=always
RestartSec=10

[Install]
WantedBy=graphical-session.target
